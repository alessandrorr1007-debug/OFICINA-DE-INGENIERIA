# Variables de entorno para Paul Engineering Studio en Netlify
# IMPORTANTE: No agregues contraseñas reales en este archivo ni lo subas con credenciales.

# Contraseña de acceso a la oficina privada (configurar en el panel de Netlify)
APP_PASSWORD=tu_contraseña_aqui

# Secreto criptográfico aleatorio para firmar las cookies de sesión (al menos 32 caracteres)
# Genera uno ejecutando en tu terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=tu_clave_secreta_aleatoria_aqui

# Clave simétrica para cifrar las credenciales de las estaciones (AES-256-GCM) en Netlify Blobs
# Genera una ejecutando en tu terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
